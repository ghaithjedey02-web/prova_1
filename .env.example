# AI provider selection. Defaults to `mock` (offline, no key required).
# mock | anthropic | openai-compatible
DOLMIR_AI_PROVIDER=mock

# Required when DOLMIR_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Required for hosted OpenAI-compatible endpoints (not needed for local Ollama/vLLM)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Notion integration for the prospecting pipeline (see packages/prospecting)
# NOTION_API_KEY=
