{
  "name": "dolmir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dolmir — AI implementation for Lombardy SMEs. Monorepo.",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run demo --workspace @dolmir/rfq-engine",
    "prospect": "npm run cli --workspace @dolmir/prospecting"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
